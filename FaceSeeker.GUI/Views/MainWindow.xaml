<Window x:Class="FaceSeeker.GUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FaceSeeker.GUI.ViewModels"
        xmlns:controls="clr-namespace:FaceSeeker.GUI.Controls"
        xmlns:models="clr-namespace:FaceSeeker.GUI.Models"
        Title="FaceSeeker"
        Width="1200"
        Height="780"
        MinWidth="980"
        MinHeight="600"
        Background="#090A0C"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: Clean Application Header -->
        <Border Grid.Row="0"
                Background="#0E1014"
                BorderBrush="#1A1D24"
                BorderThickness="0,0,0,1"
                Padding="16,0"
                SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FaceSeeker"
                               Foreground="#F1F5F9"
                               FontSize="13.5"
                               FontWeight="SemiBold" />
                    <Border Background="#161A22"
                            BorderBrush="#252B37"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="5,1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="YuNet / SFace"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="Medium" />
                    </Border>
                </StackPanel>

                <!-- Action Bar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Clear"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearResultsCommand}"
                            Margin="0,0,6,0" />
                    <Button Content="Export..."
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportCommand}"
                            Margin="0,0,6,0" />
                    <Button Content="Settings"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN 3-COLUMN WORKSPACE -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: TARGET FACES -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="TARGET FACES"
                                   Style="{StaticResource SectionHeader}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TargetFaces.Count}"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <controls:DropZone Grid.Row="1"
                                       AcceptedExtensions=".jpg;.jpeg;.png;.bmp"
                                       LabelText="Drop target photos"
                                       FilesDropped="{Binding HandleImageDropCommand}"
                                       Margin="0,0,0,8" />

                    <Button Grid.Row="2"
                            Content="+ Add Target Photo"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddTargetFaceCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,10" />

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TargetFaces}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TargetFaceItem}">
                                    <controls:TargetFaceCard RemoveCommand="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CENTER COLUMN: MATCH RESULTS STREAM -->
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="4,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="MATCH RESULTS" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding Results.Count, StringFormat=' ({0})'}"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       FontWeight="Medium" />
                        </StackPanel>

                        <!-- Scan Trigger -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Cancel"
                                    Style="{StaticResource DestructiveButton}"
                                    Command="{Binding CancelScanCommand}"
                                    IsEnabled="{Binding IsScanning}"
                                    Margin="0,0,6,0" />
                            <Button Content="Start Scan"
                                    Command="{Binding StartScanCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Empty State Placeholder -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding Results.Count, Converter={StaticResource BoolToVis}, FallbackValue=Visible}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No matches detected"
                                   Foreground="#94A3B8"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Add target faces and videos, then click Start Scan."
                                   Foreground="#475569"
                                   FontSize="11.5"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Match Rows List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MatchResultViewModel}">
                                    <controls:MatchResultRow Result="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: VIDEO FILES -->
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="VIDEOS TO SCAN"
                                   Style="{StaticResource SectionHeader}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding VideoFiles.Count}"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <controls:DropZone Grid.Row="1"
                                       AcceptedExtensions=".mp4;.avi;.mkv;.mov;.wmv"
                                       LabelText="Drop video files"
                                       FilesDropped="{Binding HandleVideoDropCommand}"
                                       Margin="0,0,0,8" />

                    <Button Grid.Row="2"
                            Content="+ Add Videos"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddVideosCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,10" />

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VideoFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#13161B"
                                            BorderBrush="#1F242D"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="8,6"
                                            Margin="0,0,0,5"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding}"
                                                       Foreground="#CBD5E1"
                                                       FontSize="11.5"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Width="20"
                                                    Height="20"
                                                    FontSize="10"
                                                    Foreground="#64748B"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#281315" />
                                                                            <Setter Property="Foreground" Value="#EF4444" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR (Flat VS Code / Sublime / JetBrains style) -->
        <Border Grid.Row="2"
                Background="#0E1014"
                BorderBrush="#1A1D24"
                BorderThickness="0,1,0,0"
                Padding="16,0"
                SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Foreground="#94A3B8"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Thin Minimal Progress Bar -->
                <ProgressBar Grid.Column="1"
                             Style="{StaticResource CustomProgressBar}"
                             Minimum="0"
                             Maximum="{Binding ProgressMax}"
                             Value="{Binding ProgressValue}"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0" />

                <!-- Percentage -->
                <TextBlock Grid.Column="2"
                           Text="{Binding ProgressPct}"
                           Foreground="#64748B"
                           FontFamily="Consolas, Cascadia Code, JetBrains Mono"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>