<UserControl x:Class="FaceSeeker.GUI.Controls.MatchResultRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="RowBorder"
            Margin="0,0,0,4"
            Padding="10,8"
            CornerRadius="5"
            BorderThickness="1"
            Background="#12151A"
            BorderBrush="#1B2028"
            SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#171C23" />
                        <Setter Property="BorderBrush" Value="#2A313E" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>

            <!-- Face Thumbnail 42x42 -->
            <Border Grid.Column="0"
                    Width="42"
                    Height="42"
                    CornerRadius="4"
                    ClipToBounds="True"
                    Background="#090A0C"
                    BorderBrush="#242934"
                    BorderThickness="1">
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
            </Border>

            <!-- Target Name & Metadata -->
            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TargetName}"
                               Foreground="#F1F5F9"
                               FontWeight="SemiBold"
                               FontSize="13" />

                    <!-- Minimalist Confidence Tag -->
                    <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1C1E24" />
                                <Setter Property="BorderBrush" Value="#2A2F3B" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighConf}" Value="True">
                                        <Setter Property="Background" Value="#0F2418" />
                                        <Setter Property="BorderBrush" Value="#166534" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ConfidencePct}" FontSize="10" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHighConf}" Value="True">
                                            <Setter Property="Foreground" Value="#22C55E" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Video file reference -->
                <TextBlock Text="{Binding VideoName}"
                           Foreground="#64748B"
                           FontSize="11"
                           Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Timestamp & Technical Bar -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{Binding TimestampStr}"
                           Foreground="#CBD5E1"
                           FontFamily="Consolas, Cascadia Code, JetBrains Mono"
                           FontWeight="Medium"
                           FontSize="11.5"
                           HorizontalAlignment="Right" />
                <ProgressBar Margin="0,5,0,0"
                             Width="90"
                             Height="3"
                             Minimum="0"
                             Maximum="1"
                             Value="{Binding Confidence}"
                             Foreground="#3B82F6"
                             Background="#1B2028"
                             BorderThickness="0">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="Root" SnapsToDevicePixels="True">
                                <Border Background="{TemplateBinding Background}" CornerRadius="1" />
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="1"
                                        HorizontalAlignment="Left" />
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>